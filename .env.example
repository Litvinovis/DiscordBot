# ============================================================
# Stonks Bot — пример переменных окружения
# Скопируй этот файл в .env и заполни реальными значениями.
# Файл .env НЕ должен попасть в git (он добавлен в .gitignore).
# ============================================================

# Discord
DISCORD_BOT_TOKEN=your-discord-bot-token-here
DISCORD_ALLOWED_CHANNEL_IDS=1157258712138907700

# Tinkoff Invest API
TINKOFF_TOKEN=your-tinkoff-invest-api-token-here
# Режим API: prod | sandbox | readonly
TINKOFF_API_MODE=readonly

# Отчёты (канал Discord для рассылки статистики)
DISCORD_REPORT_GUILD_ID=651802173495181322
DISCORD_REPORT_CHANNEL_NAME=ботный
CURRENCY_REPORT_CRON=0 0 11 * * *
SHARES_REPORT_CRON=0 5 11 * * *

# Торговая песочница
SANDBOX_START_BALANCE=1000000.00
SANDBOX_COMMISSION_RATE=0.001
SANDBOX_MAX_LEVERAGE=3.0
SANDBOX_MAINTENANCE_MARGIN=0.25

# Apache Ignite (persistence)
IGNITE_LOCAL_ADDRESS=127.0.0.1
IGNITE_DISCOVERY_ADDRESSES=127.0.0.1:47500..47509
IGNITE_WORK_DIR=/tmp/ignite-stonks-client

# Telegram уведомления (используется в GitHub Actions)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here
